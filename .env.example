# Optional API keys and contact details for AckFinder.
# Copy this file to .env (in the folder that holds config.yaml, or where you run the
# command) and fill in what you have. Nothing here is required. Never commit or share .env.
# Variables already set in your shell take precedence over this file.

# OpenAlex: free personal key (create an account at openalex.org; see
# https://help.openalex.org/how-to-use-the-api/rate-limits-and-authentication).
# Without a key OpenAlex returns only the first page of results and often rate-limits.
OPENALEX_API_KEY=

# NCBI E-utilities (PubMed, PMC): free key from your NCBI account settings.
# Raises the limit from 3 to 10 requests per second.
NCBI_API_KEY=
# NCBI asks API users for a contact e-mail address.
NCBI_EMAIL=

# Use a config file other than ./config.yaml (optional; only read from a .env in the
# folder where you run the command).
# ACKFINDER_CONFIG=/path/to/config.yaml
